{
  "name": "docuweb-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --import ./node_modules/dotenv/config ./node_modules/.bin/tsx main/server/index.ts",
    "preview": "vite preview",
    "server": "tsx watch main/server/index.ts",
    "dev:all": "npm run dev & npm run server",
    "db:generate": "prisma generate --schema=main/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=main/prisma/schema.prisma",
    "db:seed": "tsx main/prisma/seed.ts",
    "db:studio": "prisma studio --schema=main/prisma/schema.prisma"
  },
  "dependencies": {
    "@clerk/backend": "^1.24.0",
    "@clerk/clerk-react": "^5.22.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "motion": "^11.18.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
