{
  "name": "docuweb-ai-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "predeploy": "node scripts/copy-server.js",
    "build:prisma": "prisma generate --schema=prisma/schema.prisma",
    "deploy": "npm run predeploy && npm run build:prisma && firebase deploy --only functions",
    "emulate": "npm run predeploy && npm run build:prisma && firebase emulators:start --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@clerk/backend": "^1.24.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "archiver": "^7.0.0",
    "pg": "^8.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "prisma": "^6.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "20"
  }
}
